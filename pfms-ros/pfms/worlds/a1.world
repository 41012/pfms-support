          </sensor>
          <sensor element_id="camera::camera_sensor" action="modify">
            <update_rate>30</update_rate>
            <topic>audibot/image_raw</topic>
          </sensor>
        </experimental:params>
      </include>
    </model> -->

  </world>
</sdf>

