<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

<!-- Replace the existing 'boxes' model with these two separate models -->

<model name='box1'>
  <pose>10 2 0.275 0 0 0</pose> <!-- Bottom box positioned at half its height -->
  
  <link name='box1'>
    <visual name='visual'>
      <geometry>
        <box>
          <size>0.55 0.55 0.55</size>
        </box>
      </geometry>
      <material>
        <ambient>1 0 0 1</ambient>
        <diffuse>1 0 0 1</diffuse>
        <specular>1 0 0 1</specular>
      </material>
    </visual>
    <collision name='collision'>
      <geometry>
        <box>
          <size>0.55 0.55 0.55</size>
        </box>
      </geometry>
    </collision>
    <inertial>
      <mass>1.0</mass>
      <inertia>
        <ixx>0.050458</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.050458</iyy>
        <iyz>0</iyz>
        <izz>0.050458</izz>
      </inertia>
    </inertial>
  </link>
</model>

<model name='box2'>
  <pose>10 2 1.1 0 0 0</pose> <!-- Top box positioned above Box1 -->
  
  <link name='box2'>
    <visual name='visual'>
      <geometry>
        <box>
          <size>2.0 2.0 1.0</size> <!-- Made collision and visual sizes consistent -->
        </box>
      </geometry>
      <material>
        <ambient>0 0 1 1</ambient>
        <diffuse>0 0 1 1</diffuse>
        <specular>0 0 1 1</specular>
      </material>
    </visual>
    <collision name='collision'>
      <geometry>
        <box>
          <size>2.0 2.0 1.0</size>
        </box>
      </geometry>
    </collision>
    <inertial>
      <mass>1.0</mass>
      <inertia>
        <ixx>0.166667</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.166667</iyy>
        <iyz>0</iyz>
        <izz>0.166667</izz>
      </inertia>
    </inertial>
  </link>
</model> 


<model name='box3'>
  <pose>10 10 0.5 0 0 0</pose> <!-- Top box positioned above Box1 -->
  
  <link name='box3'>
    <visual name='visual'>
      <geometry>
        <box>
          <size>2.0 2.0 1.0</size> <!-- Made collision and visual sizes consistent -->
        </box>
      </geometry>
      <material>
        <ambient>0 1 0 1</ambient>
        <diffuse>0 1 0 1</diffuse>
        <specular>0 1 0 1</specular>
      </material>
    </visual>
    <collision name='collision'>
      <geometry>
        <box>
          <size>2.0 2.0 1.0</size>
        </box>
      </geometry>
    </collision>
    <inertial>
      <mass>1.0</mass>
      <inertia>
        <ixx>0.166667</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.166667</iyy>
        <iyz>0</iyz>
        <izz>0.166667</izz>
      </inertia>
    </inertial>
  </link>
</model> 

    <model name='crash_dummy'>
      <pose>20.0 20.0 0.5 0 -0 0</pose>
      <link name='link'>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
          <pose>0 0 0 0 -0 0</pose>
        </inertial>
        <collision name='collision'>
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>1.0</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- <model name="audibot">
      <self_collide>false</self_collide>
      <pose>0 0 0 0 0 0</pose>
      <include merge="true">
        <uri>package://audibot_description/models/orange_audibot</uri>
        <experimental:params>
          <sensor element_id="base_footprint::navsat_sensor" action="modify">
            <update_rate>5</update_rate>
            <topic>audibot/navsat</topic>
