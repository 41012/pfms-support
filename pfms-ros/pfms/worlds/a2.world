<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>
    
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='asphalt_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>150 150 0.1</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <box>
              <size>150 150 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <pose>0 0 0 0 -0 0</pose>
    </model>    

    <!-- Manually placed walls instead of population (Gazebo Harmonic compatibility) -->
    <!-- Row 1 -->
    <model name='wall_0_0'>
      <pose>-40 -10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_0_1'>
      <pose>-20 -10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_0_2'>
      <pose>0 -10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_0_3'>
      <pose>20 -10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_0_4'>
      <pose>40 -10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <!-- Row 2 -->
    <model name='wall_1_0'>
      <pose>-40 10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_1_1'>
      <pose>-20 10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_1_2'>
      <pose>0 10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_1_3'>
      <pose>20 10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_1_4'>
      <pose>40 10 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <!-- Row 3 -->
    <model name='wall_2_0'>
      <pose>-40 30 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_2_1'>
      <pose>-20 30 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_2_2'>
      <pose>0 30 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_2_3'>
      <pose>20 30 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>
    
    <model name='wall_2_4'>
      <pose>40 30 2.25 0 0 0</pose>
      <include>
        <uri>closed_green_wall</uri>
      </include>
      <static>true</static>
    </model>

    <model name='box1'>
      <pose>10 2 0.275 0 0 0</pose> <!-- Bottom box positioned at half its height -->
      
      <link name='box1'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.55 0.55 0.55</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.55 0.55 0.55</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.050458</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.050458</iyy>
            <iyz>0</iyz>
            <izz>0.050458</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-30.7614 1.32089 33.8068 0 0.655644 0.025013</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>

