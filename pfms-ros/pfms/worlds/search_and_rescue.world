<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>

    <scene>
      <ambient>0.4 0.4 0.4</ambient>
      <background>0.25 0.25 0.25</background>
      <sky>
        <sunset>20</sunset>
      </sky>
    </scene>

    <!-- Sun light source -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <population name="open_air_jail">
      <model name="wall">
        <include>
          <static>true</static>
          <uri>model://closed_green_wall</uri>
        </include>
      </model>
      <pose>0 0 2.25 0 0 0</pose>
      <distribution>
        <type>grid</type>
        <rows>2</rows>
        <cols>4</cols>
        <step>15 15 0</step>
      </distribution>
    </population>
    <!--population name="desperate_masses">
      <model name="survivor">
        <include>
          <static>true</static>
          <uri>model://person_standing</uri>
        </include>
      </model>
      <pose>0 0 0 0 0 0</pose>
      <distribution>
        <type>grid</type>
        <rows>2</rows>
        <cols>4</cols>
        <step>15 15 0</step>
      </distribution>
    </population-->
    <model name="survivor1">
        <pose>9 -5.8 0 0 0 0</pose>
        <include>
          <!--static>true</static-->
          <uri>model://person_standing</uri>
        </include>
    </model> 

    <model name="survivor2">
        <pose>-20.73 -8.9 0 0 0 0</pose>
        <include>
          <!--static>true</static-->
          <uri>model://person_standing</uri>
        </include>
    </model>    

    <model name="survivor3">
        <pose>22.5 7.5 0 0 0 0</pose>
        <include>
          <!--static>true</static-->
          <uri>model://person_standing</uri>
        </include>
    </model> 


    <model name="survivor4">
        <pose>7.5 9.2 0 0 0 0</pose>
        <include>
          <!--static>true</static-->
          <uri>model://person_standing</uri>
        </include>
    </model> 

    <model name="survivor5">
        <pose>9.5 9.2 0 0 0 0</pose>
        <include>
          <!--static>true</static-->
          <uri>model://person_standing</uri>
        </include>
    </model> 

    <!--model name="test_model">
      <static>true</static>
      <link name="link">
        <visual name="visual_10">
          <pose>0 0 3.0  0 0 0</pose>
          <transparency>0.5</transparency>
          <geometry>
            <box><size>60 40 6</size></box>
          </geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model-->

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>30.117 -1.44701 68.7992 0 1.21164 3.13219</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>


  </world>
</sdf>
